XAI_API_KEY=your-xai-api-key
# AUTEUR_MODEL=grok-4.6

# Clip renderer: 'grok' (hosted Grok Imagine), 'h3' (MiniMax H3 on local
# ComfyUI), or 'minimax' (MiniMax H3 on the hosted minimax.io API).
# Agent inference and generate_image always use the xAI API.
# AUTEUR_VIDEO=minimax
# AUTEUR_H3_URL=http://127.0.0.1:8189

MINIMAX_API_KEY=your-minimax-jwt-here
# MINIMAX_BASE_URL=https://api.minimax.io

# Optional. Required only for narrated film productions.
ELEVENLABS_API_KEY=your-elevenlabs-key-here
# ELEVENLABS_MODEL=eleven_multilingual_v2
